// deckterm.cobanov.dev: static files only, no Worker code. A push to main that touches site/ deploys it: Workers Builds
// runs `npx wrangler deploy` in this folder. Running that here by hand still works.
{
  "name": "deckterm-site",
  "compatibility_date": "2026-10-01",
  "account_id": "c7127d8fc0f65ab18ec12bdd78dd3859",
  "assets": {
    "directory": "./public",
    // /privacy serves privacy.html; unknown paths get 404.html with a 404 status
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "deckterm.cobanov.dev", "custom_domain": true }]
}
